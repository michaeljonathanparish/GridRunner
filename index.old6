<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>GRIDRUNNER</title>
<style>
  :root {
    --bg: #000;
    --fg: #fff;
    --player: #29b6ff;
    --enemy: #ff3b3b;
    --dim: #555;
  }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: var(--bg); color: var(--fg);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    overflow: hidden;
    user-select: none;
    overscroll-behavior: none;
  }
  canvas, #dpad { touch-action: none; }
  #wrap {
    position: fixed; inset: 0;
    display: grid; place-items: center;
  }
  canvas {
    display: block;
    image-rendering: pixelated;
    box-shadow: 0 0 60px rgba(41,182,255,0.05);
  }
  #hud {
    position: fixed; top: 12px; left: 0; right: 0;
    display: flex; justify-content: space-between;
    padding: 0 18px;
    font-size: 13px; letter-spacing: 0.18em;
    pointer-events: none;
    text-transform: uppercase;
  }
  #hud span { opacity: 0.85; }
  #hud b { color: var(--player); font-weight: 600; }
  .overlay {
    position: fixed; inset: 0;
    display: grid; place-items: center;
    background: rgba(0,0,0,0.86);
    backdrop-filter: blur(2px);
    z-index: 10;
  }
  .panel {
    text-align: center;
    padding: 28px 36px;
    border: 1px solid rgba(255,255,255,0.15);
    min-width: 280px;
  }
  .panel h1 {
    margin: 0 0 6px;
    font-size: 28px;
    letter-spacing: 0.4em;
    font-weight: 600;
  }
  .panel h1 .accent { color: var(--player); }
  .panel p {
    margin: 6px 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .panel input {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    text-align: center;
    padding: 6px 4px;
    width: 200px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    outline: none;
  }
  .panel input:focus { border-bottom-color: var(--player); }
  .panel .keys {
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: 0.16em;
    opacity: 0.55;
    line-height: 1.9;
  }
  .panel .keys kbd {
    display: inline-block;
    border: 1px solid rgba(255,255,255,0.25);
    padding: 1px 6px;
    margin: 0 2px;
    border-radius: 2px;
    font-size: 10px;
  }
  .panel .high {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.18em;
  }
  .panel .high b { color: var(--player); font-weight: 600; }
  .blink { animation: blink 1.2s steps(2,end) infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }
  .hidden { display: none !important; }

  /* Split touch controls: up/down on the left, left/right on the right.
     Hidden by default; shown when body has .touch class. */
  #pad-left, #pad-right {
    position: fixed;
    bottom: 24px;
    display: none;
    z-index: 5;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  body.touch #pad-left, body.touch #pad-right { display: block; }
  body.touch #hud { font-size: 11px; padding: 0 12px; }
  /* Left cluster: up over down, stacked vertically */
  #pad-left {
    left: 18px;
    width: 120px; height: 248px; /* 120 + 8 gap + 120 */
  }
  /* Right cluster: left and right side by side */
  #pad-right {
    right: 18px;
    width: 248px; height: 120px;
    bottom: 88px; /* lifted so the cluster is roughly thumb-aligned with the left one */
  }
  .pad-btn {
    position: absolute;
    width: 120px; height: 120px;
    display: grid; place-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 16px;
    color: var(--fg);
    font-size: 44px;
    line-height: 1;
    -webkit-tap-highlight-color: transparent;
  }
  .pad-btn.active {
    background: rgba(41,182,255,0.25);
    border-color: var(--player);
    color: var(--player);
  }
  #pad-left  .up    { top: 0; left: 0; }
  #pad-left  .down  { bottom: 0; left: 0; }
  #pad-right .left  { top: 0; left: 0; }
  #pad-right .right { top: 0; right: 0; }

  /* Touch overlays: bigger tap targets, scrollable if keyboard appears */
  body.touch .panel { padding: 22px 24px; min-width: 0; max-width: 86vw; }
  body.touch .panel h1 { font-size: 22px; letter-spacing: 0.32em; }
  body.touch .panel input { width: 70vw; max-width: 240px; font-size: 16px; }
  body.touch .overlay { align-items: start; padding-top: 8vh; }
  body.touch #wrap { align-items: start; padding-top: 40px; justify-items: stretch; }
  body.touch canvas { box-shadow: none; }
</style>
</head>
<body>
<div id="hud">
  <span>LVL <b id="hud-level">1</b></span>
  <span>SCORE <b id="hud-score">0</b></span>
  <span><b id="hud-fill">0%</b> COVERED</span>
</div>

<div id="wrap"><canvas id="game" width="720" height="720"></canvas></div>

<div class="overlay" id="menu">
  <div class="panel">
    <h1>GRID<span class="accent">RUNNER</span></h1>
    <p>Paint every line. Don't get caught.</p>
    <p style="margin-top:18px;">Enter name</p>
    <input id="name" maxlength="12" autocomplete="off">
    <div class="high">HI <b id="hi-name">—</b> &nbsp; <b id="hi-score">0</b></div>
    <div class="keys" id="keys-hint">
      <div><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd> or <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> — move</div>
      <div><kbd>Space</kbd> — start</div>
    </div>
    <p class="blink" id="start-hint" style="margin-top:18px;">▸ press space ◂</p>
  </div>
</div>

<div class="overlay hidden" id="gameover">
  <div class="panel">
    <h1 id="go-title">GAME OVER</h1>
    <p id="go-sub">Caught on level 1</p>
    <div class="high">SCORE <b id="go-score">0</b></div>
    <div class="high" id="go-newhigh" style="display:none;color:var(--player);">NEW HIGH SCORE</div>
    <p class="blink" id="go-hint" style="margin-top:22px;">▸ press space ◂</p>
  </div>
</div>

<div id="pad-left" aria-hidden="true">
  <div class="pad-btn up"    data-dir="up">▲</div>
  <div class="pad-btn down"  data-dir="down">▼</div>
</div>
<div id="pad-right" aria-hidden="true">
  <div class="pad-btn left"  data-dir="left">◀</div>
  <div class="pad-btn right" data-dir="right">▶</div>
</div>

<script>
(() => {
  // ------- storage -------
  const KEY = "gridrunner.v1";
  const load = () => {
    try { return JSON.parse(localStorage.getItem(KEY)) || {}; }
    catch { return {}; }
  };
  const save = (o) => {
    try { localStorage.setItem(KEY, JSON.stringify(o)); } catch {}
  };
  let store = load();
  store.name = store.name || "";
  store.hiScore = store.hiScore || 0;
  store.hiName = store.hiName || "—";

  // ------- canvas / sizing -------
  const cvs = document.getElementById("game");
  const ctx = cvs.getContext("2d");
  function resize() {
    const isTouchLayout = document.body.classList.contains("touch");
    if (isTouchLayout) {
      // Left cluster is 248px tall, sits with 24px bottom margin → pads occupy ~272px from bottom.
      // Add some breathing room so the player isn't hidden behind buttons.
      const reservedBottom = 300;
      const reservedTop = 40;     // HUD
      cvs.width = Math.max(280, window.innerWidth - 10);
      cvs.height = Math.max(280, window.innerHeight - reservedTop - reservedBottom);
    } else {
      const size = Math.max(280, Math.floor(Math.min(window.innerWidth, window.innerHeight) - 20));
      cvs.width = size; cvs.height = size;
    }
    if (state.phase === "play") render();
  }
  window.addEventListener("resize", resize);

  // ------- input -------
  const keys = {};
  const dirOf = (k) => {
    if (k === "ArrowUp" || k === "KeyW") return [0,-1];
    if (k === "ArrowDown" || k === "KeyS") return [0,1];
    if (k === "ArrowLeft" || k === "KeyA") return [-1,0];
    if (k === "ArrowRight" || k === "KeyD") return [1,0];
    return null;
  };
  window.addEventListener("keydown", (e) => {
    if (["ArrowUp","ArrowDown","ArrowLeft","ArrowRight"," ","Space"].includes(e.key) || e.code === "Space") e.preventDefault();
    keys[e.code] = true;
    if (e.code === "Space") {
      if (state.phase === "menu") startGame();
      else if (state.phase === "gameover") { showMenu(); }
    }
    const d = dirOf(e.code);
    if (d && state.phase === "play") {
      state.queued = d;
    }
  });
  window.addEventListener("keyup", (e) => { keys[e.code] = false; });

  // ------- level generation -------
  // The grid is a graph of cells. Each cell has up to 4 edges.
  // An "edge" is a wall segment between two cells (or between a cell and outside).
  // We track which edges EXIST (open paths) and which are PAINTED.
  // The level shape itself can be irregular (cells removed) at higher levels.

  function makeLevel(n) {
    // Difficulty curve — gentle, with new enemies introduced slow and ramping up.
    // Grid grows steadily so the player has more room to evade as threats add up.
    const size = Math.min(3 + Math.floor(n / 1.5), 9);              // 3..9 cells per side
    const gapChance = Math.min(0.04 + n * 0.018, 0.26);             // softer gap ramp
    const cellRemoveChance = n >= 4 ? Math.min((n-3) * 0.035, 0.18) : 0; // irregular from L4

    // Enemy count: introduces one at a time, well-spaced.
    //   L1     → 0
    //   L2-5   → 1
    //   L6-9   → 2
    //   L10-13 → 3
    //   L14+   → 4
    let enemyCount = 0;
    if (n >= 2)  enemyCount = 1;
    if (n >= 6)  enemyCount = 2;
    if (n >= 10) enemyCount = 3;
    if (n >= 14) enemyCount = 4;

    // Each enemy has its own speed based on how long it's been around.
    // An enemy "introduced" at level L gets a base speed and ramps up over the
    // following ~8 levels until it caps. A freshly introduced enemy is noticeably
    // slower so the player has time to read it.
    const enemyIntroLevel = [2, 6, 10, 14]; // when each enemy first appears
    const enemySpeeds = [];
    for (let i = 0; i < enemyCount; i++) {
      const intro = enemyIntroLevel[i];
      const tenure = n - intro;                            // levels since this enemy joined
      const ramp = Math.min(tenure / 8, 1);                // 0..1 over 8 levels
      const speed = 2.0 + ramp * 1.6;                      // 2.0 → 3.6 cells/sec
      enemySpeeds.push(speed);
    }

    // Player speed grows slowly so they keep an edge over fresh enemies.
    const playerSpeed = 4.0 + Math.min(n, 12) * 0.18;      // 4.18 → 6.16 by L12, then flat

    // Build cell grid; mark some cells as "absent" to make irregular shape
    const cells = [];
    for (let y = 0; y < size; y++) {
      const row = [];
      for (let x = 0; x < size; x++) row.push(true);
      cells.push(row);
    }
    if (cellRemoveChance > 0) {
      // remove cells from corners/edges only, and ensure connectivity
      const candidates = [];
      for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
        const edge = (x===0||y===0||x===size-1||y===size-1);
        if (edge && Math.random() < cellRemoveChance) candidates.push([x,y]);
      }
      for (const [x,y] of candidates) {
        cells[y][x] = false;
        if (!isConnected(cells, size)) cells[y][x] = true;
      }
    }

    // Build edges. An edge is between two adjacent present cells.
    // Each edge is either OPEN (passable) or BLOCKED (wall - the gap in the user's diagram).
    // Wait — re-reading the brief: gaps in the grid create dead ends. In the reference image,
    // the WHITE LINES are paths; missing white lines are gaps. So:
    // - present edges = passable corridors the player runs along
    // - missing edges = "gaps that can't be crossed"
    // We start with all adjacent edges present, then remove some to make dead ends.
    // We must keep the graph connected.

    const edges = new Map(); // key "x1,y1-x2,y2" canonical -> {painted:false}
    const edgeKey = (x1,y1,x2,y2) => {
      if (x2 < x1 || (x2===x1 && y2<y1)) [x1,y1,x2,y2] = [x2,y2,x1,y1];
      return `${x1},${y1}-${x2},${y2}`;
    };
    const addEdge = (x1,y1,x2,y2) => edges.set(edgeKey(x1,y1,x2,y2), { painted: false });

    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
      if (!cells[y][x]) continue;
      if (x+1 < size && cells[y][x+1]) addEdge(x,y,x+1,y);
      if (y+1 < size && cells[y+1][x]) addEdge(x,y,x,y+1);
    }

    // Remove edges to introduce gaps, while keeping graph connected
    const edgeList = [...edges.keys()];
    shuffle(edgeList);
    const targetRemovals = Math.floor(edges.size * gapChance);
    let removed = 0;
    for (const k of edgeList) {
      if (removed >= targetRemovals) break;
      const saved = edges.get(k);
      edges.delete(k);
      if (graphConnected(cells, edges, size)) removed++;
      else edges.set(k, saved);
    }

    // Find a starting cell (top-left present cell)
    let start = null;
    outer: for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
      if (cells[y][x]) { start = [x,y]; break outer; }
    }

    // Place enemies far from player, each with their own speed
    const enemyStarts = [];
    const dists = bfsDistances(cells, edges, size, start);
    const sortedCells = [];
    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
      if (cells[y][x] && dists[y][x] !== Infinity) sortedCells.push([x,y,dists[y][x]]);
    }
    sortedCells.sort((a,b) => b[2]-a[2]);
    for (let i = 0; i < enemyCount && i < sortedCells.length; i++) {
      enemyStarts.push({
        x: sortedCells[i][0],
        y: sortedCells[i][1],
        speed: enemySpeeds[i],
      });
    }

    return {
      n, size, cells, edges,
      start, enemyStarts,
      playerSpeed,
    };
  }

  function shuffle(a) {
    for (let i = a.length-1; i > 0; i--) {
      const j = Math.floor(Math.random()*(i+1));
      [a[i],a[j]] = [a[j],a[i]];
    }
    return a;
  }

  function isConnected(cells, size) {
    let first = null;
    for (let y = 0; y < size && !first; y++)
      for (let x = 0; x < size && !first; x++)
        if (cells[y][x]) first = [x,y];
    if (!first) return false;
    const seen = Array.from({length:size}, () => Array(size).fill(false));
    const q = [first]; seen[first[1]][first[0]] = true;
    let count = 1, total = 0;
    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) if (cells[y][x]) total++;
    while (q.length) {
      const [x,y] = q.shift();
      for (const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]) {
        const nx=x+dx, ny=y+dy;
        if (nx<0||ny<0||nx>=size||ny>=size) continue;
        if (cells[ny][nx] && !seen[ny][nx]) { seen[ny][nx]=true; q.push([nx,ny]); count++; }
      }
    }
    return count === total;
  }

  function neighborsOf(x, y, edges, size) {
    const ns = [];
    const tries = [[1,0],[-1,0],[0,1],[0,-1]];
    for (const [dx,dy] of tries) {
      const nx=x+dx, ny=y+dy;
      if (nx<0||ny<0||nx>=size||ny>=size) continue;
      const k = (nx<x||ny<y) ? `${nx},${ny}-${x},${y}` : `${x},${y}-${nx},${ny}`;
      if (edges.has(k)) ns.push([nx,ny]);
    }
    return ns;
  }

  function graphConnected(cells, edges, size) {
    let first = null;
    for (let y = 0; y < size && !first; y++)
      for (let x = 0; x < size && !first; x++)
        if (cells[y][x]) first = [x,y];
    if (!first) return false;
    const seen = Array.from({length:size}, () => Array(size).fill(false));
    const q = [first]; seen[first[1]][first[0]] = true;
    let count = 1, total = 0;
    for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) if (cells[y][x]) total++;
    while (q.length) {
      const [x,y] = q.shift();
      for (const [nx,ny] of neighborsOf(x,y,edges,size)) {
        if (!seen[ny][nx]) { seen[ny][nx]=true; q.push([nx,ny]); count++; }
      }
    }
    return count === total;
  }

  function bfsDistances(cells, edges, size, start) {
    const d = Array.from({length:size}, () => Array(size).fill(Infinity));
    d[start[1]][start[0]] = 0;
    const q = [start];
    while (q.length) {
      const [x,y] = q.shift();
      for (const [nx,ny] of neighborsOf(x,y,edges,size)) {
        if (d[ny][nx] === Infinity) { d[ny][nx] = d[y][x]+1; q.push([nx,ny]); }
      }
    }
    return d;
  }

  // BFS to find next step from (sx,sy) toward (tx,ty)
  function stepToward(sx, sy, tx, ty, edges, size) {
    if (sx===tx && sy===ty) return null;
    const prev = Array.from({length:size}, () => Array(size).fill(null));
    const seen = Array.from({length:size}, () => Array(size).fill(false));
    seen[sy][sx] = true;
    const q = [[sx,sy]];
    while (q.length) {
      const [x,y] = q.shift();
      if (x===tx && y===ty) {
        // walk back
        let cx=x, cy=y;
        while (true) {
          const p = prev[cy][cx];
          if (!p) return null;
          if (p[0]===sx && p[1]===sy) return [cx-sx, cy-sy];
          cx=p[0]; cy=p[1];
        }
      }
      for (const [nx,ny] of neighborsOf(x,y,edges,size)) {
        if (!seen[ny][nx]) { seen[ny][nx]=true; prev[ny][nx]=[x,y]; q.push([nx,ny]); }
      }
    }
    return null;
  }

  // ------- game state -------
  const state = {
    phase: "menu",        // menu | play | gameover
    level: null,          // level data
    levelNum: 1,
    score: 0,
    player: null,         // {x,y,fx,fy,dir,moving}
    enemies: [],
    queued: null,         // queued direction
    lastT: 0,
    enemyThinkTimer: 0,
  };

  function startGame() {
    const nameEl = document.getElementById("name");
    const nm = (nameEl.value || store.name || "PLAYER").trim().toUpperCase().slice(0,12) || "PLAYER";
    store.name = nm; save(store);
    state.levelNum = 1;
    state.score = 0;
    beginLevel(state.levelNum);
    document.getElementById("menu").classList.add("hidden");
    document.getElementById("gameover").classList.add("hidden");
    state.phase = "play";
    resize();
    state.lastT = performance.now();
    requestAnimationFrame(loop);
  }

  function beginLevel(n) {
    state.level = makeLevel(n);
    state.player = {
      x: state.level.start[0], y: state.level.start[1],
      fx: state.level.start[0], fy: state.level.start[1],
      dir: [0,0],
      progress: 0, // 0..1 along current move
      target: null,
    };
    state.enemies = state.level.enemyStarts.map(({x, y, speed}) => ({
      x, y, fx:x, fy:y, progress:0, target:null, speed,
    }));
    state.queued = null;
    // Camera starts on player, snapped (no lerp on first frame)
    state.cam = { x: state.player.fx, y: state.player.fy };
    updateHUD();
  }

  function showMenu() {
    state.phase = "menu";
    document.getElementById("menu").classList.remove("hidden");
    document.getElementById("gameover").classList.add("hidden");
    refreshMenu();
  }

  function gameOver(won) {
    state.phase = "gameover";
    const isHigh = state.score > store.hiScore;
    if (isHigh) {
      store.hiScore = state.score;
      store.hiName = store.name;
      save(store);
    }
    document.getElementById("go-title").textContent = won ? "YOU WIN" : "CAUGHT";
    document.getElementById("go-sub").textContent = won
      ? `Cleared level ${state.levelNum}`
      : `Caught on level ${state.levelNum}`;
    document.getElementById("go-score").textContent = state.score;
    document.getElementById("go-newhigh").style.display = isHigh ? "block" : "none";
    document.getElementById("gameover").classList.remove("hidden");
  }

  function refreshMenu() {
    document.getElementById("name").value = store.name || "";
    document.getElementById("hi-name").textContent = store.hiName || "—";
    document.getElementById("hi-score").textContent = store.hiScore || 0;
  }

  function updateHUD() {
    document.getElementById("hud-level").textContent = state.levelNum;
    document.getElementById("hud-score").textContent = state.score;
    let total = 0, painted = 0;
    for (const e of state.level.edges.values()) { total++; if (e.painted) painted++; }
    const pct = total ? Math.floor(painted * 100 / total) : 0;
    document.getElementById("hud-fill").textContent = pct + "%";
  }

  function levelComplete() {
    for (const e of state.level.edges.values()) if (!e.painted) return false;
    return true;
  }

  // ------- movement -------
  function tryStartMove(actor, dir, edges, size) {
    if (!dir || (dir[0]===0 && dir[1]===0)) return false;
    const nx = actor.x + dir[0], ny = actor.y + dir[1];
    if (nx<0||ny<0||nx>=size||ny>=size) return false;
    const k = (nx<actor.x||ny<actor.y) ? `${nx},${ny}-${actor.x},${actor.y}` : `${actor.x},${actor.y}-${nx},${ny}`;
    if (!edges.has(k)) return false;
    actor.target = [nx,ny];
    actor.progress = 0;
    actor.dir = dir;
    return true;
  }

  function tickActor(actor, speed, dt) {
    if (!actor.target) return false;
    actor.progress += speed * dt;
    if (actor.progress >= 1) {
      actor.x = actor.target[0];
      actor.y = actor.target[1];
      actor.fx = actor.x; actor.fy = actor.y;
      actor.target = null;
      actor.progress = 0;
      return true; // arrived
    } else {
      actor.fx = actor.x + actor.dir[0] * actor.progress;
      actor.fy = actor.y + actor.dir[1] * actor.progress;
      return false;
    }
  }

  // Paint edge between (x1,y1)-(x2,y2). Returns true if newly painted.
  function paintEdge(x1,y1,x2,y2) {
    const k = (x2<x1||(x2===x1&&y2<y1)) ? `${x2},${y2}-${x1},${y1}` : `${x1},${y1}-${x2},${y2}`;
    const e = state.level.edges.get(k);
    if (!e) return false;
    if (!e.painted) { e.painted = true; return true; }
    return false;
  }

  // ------- main loop -------
  function loop(t) {
    if (state.phase !== "play") return;
    const dt = Math.min(0.05, (t - state.lastT) / 1000);
    state.lastT = t;

    update(dt);
    render();
    requestAnimationFrame(loop);
  }

  function update(dt) {
    const lvl = state.level;
    const p = state.player;

    // continuous input: held direction (used as the "default" travel)
    let held = null;
    if (keys["ArrowUp"] || keys["KeyW"]) held = [0,-1];
    else if (keys["ArrowDown"] || keys["KeyS"]) held = [0,1];
    else if (keys["ArrowLeft"] || keys["KeyA"]) held = [-1,0];
    else if (keys["ArrowRight"] || keys["KeyD"]) held = [1,0];

    // Finger-trace steering: if a touch target is set, work out the next step
    // toward it and feed it into the queue/held system. Compute from the player's
    // *upcoming* cell (the cell they're moving into) so turns happen at the right
    // intersection and not one cell late.
    if (state.touchTarget) {
      const fromX = p.target ? p.target[0] : p.x;
      const fromY = p.target ? p.target[1] : p.y;
      if (fromX === state.touchTarget.x && fromY === state.touchTarget.y) {
        // already heading to / standing on the target — no new direction
      } else {
        const step = stepToward(fromX, fromY, state.touchTarget.x, state.touchTarget.y,
                                lvl.edges, lvl.size);
        if (step) {
          // Treat this as both held and queued — held keeps the player moving
          // when they reach the target's row/column, queued takes turns at junctions.
          held = step;
          state.queued = step;
        }
      }
    }

    // Queued direction persists indefinitely — taken at the next intersection
    // where it's a valid path. Cleared when consumed or when player presses
    // a different direction. (Pac-Man-style "next available turn" input.)
    const buffered = state.queued;

    // Mid-segment: try to honour a buffered REVERSE (180°) immediately so
    // backtracking feels instant, but only on the same line.
    if (p.target && buffered) {
      const reversed = buffered[0] === -p.dir[0] && buffered[1] === -p.dir[1];
      if (reversed) {
        // swap target and traverse backwards
        const oldTarget = p.target;
        p.target = [p.x, p.y];
        p.x = oldTarget[0]; p.y = oldTarget[1];
        p.dir = buffered;
        p.progress = 1 - p.progress;
        state.queued = null;
      }
    }

    if (!p.target) {
      // At an intersection: pick best direction.
      // Priority: buffered turn > held key > continue same direction.
      const tries = [buffered, held, p.dir].filter(Boolean);
      for (const d of tries) {
        if (tryStartMove(p, d, lvl.edges, lvl.size)) {
          if (buffered && d === buffered) state.queued = null;
          break;
        }
      }
    }

    if (p.target) {
      const before = [p.x, p.y];
      const arrived = tickActor(p, lvl.playerSpeed, dt);
      if (arrived) {
        // paint the edge we just traversed
        if (paintEdge(before[0], before[1], p.x, p.y)) {
          state.score += 10;
        }
        // Pick next move at this junction.
        // Priority: buffered turn > held key > continue same direction.
        const tries = [buffered, held, p.dir].filter(Boolean);
        for (const d of tries) {
          if (tryStartMove(p, d, lvl.edges, lvl.size)) {
            if (buffered && d === buffered) state.queued = null;
            break;
          }
        }
      }
    }

    // enemies
    state.enemyThinkTimer += dt;
    for (const en of state.enemies) {
      if (!en.target) {
        // pick a direction toward player
        const step = stepToward(en.x, en.y, p.x, p.y, lvl.edges, lvl.size);
        if (step) {
          tryStartMove(en, step, lvl.edges, lvl.size);
        } else {
          // wander: any open neighbor
          const ns = neighborsOf(en.x, en.y, lvl.edges, lvl.size);
          if (ns.length) {
            const [nx,ny] = ns[Math.floor(Math.random()*ns.length)];
            tryStartMove(en, [nx-en.x, ny-en.y], lvl.edges, lvl.size);
          }
        }
      }
      tickActor(en, en.speed, dt);
    }

    // collision: distance between player and any enemy in cell-space
    for (const en of state.enemies) {
      const dx = en.fx - p.fx, dy = en.fy - p.fy;
      if (dx*dx + dy*dy < 0.20*0.20) {
        gameOver(false);
        return;
      }
    }

    updateHUD();

    // Camera: lerp toward player position. Frame-rate-independent smoothing.
    const lerpRate = 6.0; // higher = snappier follow
    const t = 1 - Math.exp(-lerpRate * dt);
    state.cam.x += (p.fx - state.cam.x) * t;
    state.cam.y += (p.fy - state.cam.y) * t;

    // level complete?
    if (levelComplete()) {
      state.score += 100 + state.levelNum * 25;
      state.levelNum++;
      beginLevel(state.levelNum);
    }
  }

  // ------- rendering -------
  function render() {
    const lvl = state.level;
    const W = cvs.width, H = cvs.height;
    ctx.fillStyle = "#000";
    ctx.fillRect(0,0,W,H);

    // Layout: two modes.
    // - Desktop (fit): scale grid to canvas with padding, no scrolling.
    // - Mobile (follow): fixed cell size, camera follows player, grid clamped to viewport.
    const isTouchLayout = document.body.classList.contains("touch");
    let cell, ox, oy;

    if (isTouchLayout) {
      // Fixed cell size for readable mobile play. Tuned so 5x5 fits a typical phone width.
      cell = Math.max(60, Math.min(90, Math.floor(W / 5)));
      const gridPxW = lvl.size * cell;
      const gridPxH = lvl.size * cell;

      if (gridPxW <= W) {
        // Grid narrower than viewport — centre it, no horizontal scroll.
        ox = (W - gridPxW) / 2;
      } else {
        // Camera follows player horizontally. Clamp so we never show empty space past the grid edge.
        const camPx = state.cam.x * cell + cell/2;
        const desiredOx = W/2 - camPx;
        ox = Math.max(W - gridPxW, Math.min(0, desiredOx));
      }
      if (gridPxH <= H) {
        oy = (H - gridPxH) / 2;
      } else {
        const camPy = state.cam.y * cell + cell/2;
        const desiredOy = H/2 - camPy;
        oy = Math.max(H - gridPxH, Math.min(0, desiredOy));
      }
    } else {
      // Desktop: fit-to-canvas with padding (original behaviour)
      const pad = 40;
      const inner = Math.min(W, H) - pad*2;
      cell = inner / lvl.size;
      ox = (W - cell*lvl.size) / 2;
      oy = (H - cell*lvl.size) / 2;
    }

    ctx.lineCap = "square";

    // First pass: unpainted edges (white)
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = Math.max(2, cell * 0.04);
    for (const [key, e] of lvl.edges) {
      if (e.painted) continue;
      drawEdge(key, ox, oy, cell);
    }

    // Second pass: painted edges (player color, with subtle glow)
    ctx.strokeStyle = "#29b6ff";
    ctx.shadowColor = "#29b6ff";
    ctx.shadowBlur = Math.max(4, cell * 0.18);
    ctx.lineWidth = Math.max(2.5, cell * 0.05);
    for (const [key, e] of lvl.edges) {
      if (!e.painted) continue;
      drawEdge(key, ox, oy, cell);
    }
    ctx.shadowBlur = 0;

    // Player — solid cyan dot, same shape as enemies
    const p = state.player;
    const pcx = ox + p.fx * cell + cell/2;
    const pcy = oy + p.fy * cell + cell/2;
    ctx.fillStyle = "#29b6ff";
    ctx.shadowColor = "#29b6ff";
    ctx.shadowBlur = Math.max(8, cell * 0.28);
    ctx.beginPath();
    ctx.arc(pcx, pcy, cell*0.10, 0, Math.PI*2);
    ctx.fill();
    ctx.shadowBlur = 0;

    // Enemies — solid red dots
    for (const en of state.enemies) {
      const ecx = ox + en.fx * cell + cell/2;
      const ecy = oy + en.fy * cell + cell/2;
      ctx.fillStyle = "#ff3b3b";
      ctx.shadowColor = "#ff3b3b";
      ctx.shadowBlur = Math.max(6, cell * 0.22);
      ctx.beginPath();
      ctx.arc(ecx, ecy, cell*0.09, 0, Math.PI*2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }
  }

  function drawEdge(key, ox, oy, cell) {
    const [a,b] = key.split("-");
    const [x1,y1] = a.split(",").map(Number);
    const [x2,y2] = b.split(",").map(Number);
    // Edge is between cell (x1,y1) and (x2,y2). It's a line segment along their shared border.
    // Convention: each cell's "lines" are on its top and left + outer right/bottom.
    // We draw the edge as the line connecting the two cell CENTERS' shared border.
    // Simpler: draw a line through the two cell centers along the shared axis,
    // but matching the screenshot, the lines are the GRID LINES themselves.
    // So: edge between two horizontally-adjacent cells is a VERTICAL line at their shared border.
    // Wait — re-reading the brief once more. The grid lines are paths. Player travels along
    // those lines. The edge between cell A and cell B is the corridor connecting them, drawn
    // as a line from center(A) to center(B). That matches the top-down player movement and
    // the painted-trail mechanic. Going with this.
    const cx1 = ox + x1*cell + cell/2;
    const cy1 = oy + y1*cell + cell/2;
    const cx2 = ox + x2*cell + cell/2;
    const cy2 = oy + y2*cell + cell/2;
    ctx.beginPath();
    ctx.moveTo(cx1, cy1);
    ctx.lineTo(cx2, cy2);
    ctx.stroke();
  }

  // ------- touch / mobile -------
  const isTouch = ("ontouchstart" in window) || (navigator.maxTouchPoints > 0);
  if (isTouch) {
    document.body.classList.add("touch");
    document.getElementById("start-hint").textContent = "▸ tap to start ◂";
    document.getElementById("go-hint").textContent = "▸ tap to restart ◂";
    const k = document.getElementById("keys-hint");
    k.innerHTML = "<div>Drag on the grid to lead the player</div><div>Or use the on-screen pad</div><div>Tap to start</div>";
  }

  // Finger-trace target: when set, the player auto-routes toward this grid cell.
  // Cleared on touchend (player coasts in current direction afterward).
  // The handler sits on the canvas; touches on the D-pad are handled by their own listeners.
  state.touchTarget = null; // {x,y} in cell coordinates, or null
  state.touchTargetId = null; // which finger is steering

  // Convert a touch's clientX/clientY to a grid cell, accounting for canvas position
  // and the camera offset on mobile.
  function touchToCell(clientX, clientY) {
    const rect = cvs.getBoundingClientRect();
    // Canvas internal pixels may differ from CSS pixels — rescale.
    const px = (clientX - rect.left) * (cvs.width / rect.width);
    const py = (clientY - rect.top)  * (cvs.height / rect.height);
    // Reconstruct the same layout the renderer uses.
    const lvl = state.level;
    if (!lvl) return null;
    const W = cvs.width, H = cvs.height;
    const isTouchLayout = document.body.classList.contains("touch");
    let cell, ox, oy;
    if (isTouchLayout) {
      cell = Math.max(60, Math.min(90, Math.floor(W / 5)));
      const gridPxW = lvl.size * cell;
      const gridPxH = lvl.size * cell;
      if (gridPxW <= W) ox = (W - gridPxW) / 2;
      else {
        const camPx = state.cam.x * cell + cell/2;
        const desiredOx = W/2 - camPx;
        ox = Math.max(W - gridPxW, Math.min(0, desiredOx));
      }
      if (gridPxH <= H) oy = (H - gridPxH) / 2;
      else {
        const camPy = state.cam.y * cell + cell/2;
        const desiredOy = H/2 - camPy;
        oy = Math.max(H - gridPxH, Math.min(0, desiredOy));
      }
    } else {
      const pad = 40;
      const inner = Math.min(W, H) - pad*2;
      cell = inner / lvl.size;
      ox = (W - cell*lvl.size) / 2;
      oy = (H - cell*lvl.size) / 2;
    }
    const cx = Math.floor((px - ox) / cell);
    const cy = Math.floor((py - oy) / cell);
    if (cx < 0 || cy < 0 || cx >= lvl.size || cy >= lvl.size) return null;
    if (!lvl.cells[cy][cx]) {
      // Snap to nearest present cell within a small radius — handy for irregular shapes
      let best = null, bestDist = Infinity;
      for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
        const nx = cx+dx, ny = cy+dy;
        if (nx<0||ny<0||nx>=lvl.size||ny>=lvl.size) continue;
        if (!lvl.cells[ny][nx]) continue;
        const d = (dx*dx + dy*dy);
        if (d < bestDist) { bestDist = d; best = [nx, ny]; }
      }
      return best ? { x: best[0], y: best[1] } : null;
    }
    return { x: cx, y: cy };
  }

  // Touch handlers on canvas — only on mobile, and only during play
  cvs.addEventListener("touchstart", (e) => {
    if (state.phase !== "play") return;
    e.preventDefault();
    const t = e.changedTouches[0];
    const cell = touchToCell(t.clientX, t.clientY);
    if (cell) {
      state.touchTarget = cell;
      state.touchTargetId = t.identifier;
    }
  }, { passive: false });

  cvs.addEventListener("touchmove", (e) => {
    if (state.phase !== "play" || state.touchTargetId === null) return;
    e.preventDefault();
    for (const t of e.changedTouches) {
      if (t.identifier !== state.touchTargetId) continue;
      const cell = touchToCell(t.clientX, t.clientY);
      if (cell) state.touchTarget = cell;
    }
  }, { passive: false });

  function endTouch(e) {
    if (state.touchTargetId === null) return;
    for (const t of e.changedTouches) {
      if (t.identifier === state.touchTargetId) {
        state.touchTarget = null;
        state.touchTargetId = null;
      }
    }
  }
  cvs.addEventListener("touchend", endTouch, { passive: false });
  cvs.addEventListener("touchcancel", endTouch, { passive: false });

  // Map D-pad buttons to the same keys the game already reads.
  // Holding a button = held key. Release = key released.
  const dpadMap = {
    up:    "ArrowUp",
    down:  "ArrowDown",
    left:  "ArrowLeft",
    right: "ArrowRight",
  };
  const activeTouches = {}; // touchId -> dir
  function pressDir(dir, btnEl) {
    const code = dpadMap[dir];
    if (!code) return;
    keys[code] = true;
    if (state.phase === "play") {
      const d = dirOf(code);
      if (d) { state.queued = d; }
    }
    if (btnEl) btnEl.classList.add("active");
  }
  function releaseDir(dir, btnEl) {
    const code = dpadMap[dir];
    if (!code) return;
    keys[code] = false;
    if (btnEl) btnEl.classList.remove("active");
  }
  document.querySelectorAll(".pad-btn").forEach((btn) => {
    const dir = btn.dataset.dir;
    btn.addEventListener("touchstart", (e) => {
      e.preventDefault();
      for (const t of e.changedTouches) activeTouches[t.identifier] = { dir, btn };
      pressDir(dir, btn);
    }, { passive: false });
    const endHandler = (e) => {
      e.preventDefault();
      for (const t of e.changedTouches) {
        const rec = activeTouches[t.identifier];
        if (rec) { releaseDir(rec.dir, rec.btn); delete activeTouches[t.identifier]; }
      }
    };
    btn.addEventListener("touchend", endHandler, { passive: false });
    btn.addEventListener("touchcancel", endHandler, { passive: false });
    // Mouse fallback for desktop testing
    btn.addEventListener("mousedown", (e) => { e.preventDefault(); pressDir(dir, btn); });
    btn.addEventListener("mouseup",   (e) => { e.preventDefault(); releaseDir(dir, btn); });
    btn.addEventListener("mouseleave",(e) => { releaseDir(dir, btn); });
  });

  // Tap on menu/gameover overlay to start (ignore taps on the input field)
  function overlayTap(e) {
    if (e.target.tagName === "INPUT") return;
    if (state.phase === "menu") startGame();
    else if (state.phase === "gameover") showMenu();
  }
  document.getElementById("menu").addEventListener("click", overlayTap);
  document.getElementById("gameover").addEventListener("click", overlayTap);

  // ------- init -------
  refreshMenu();
  // Auto-focus the name field on load
  setTimeout(() => document.getElementById("name").focus(), 100);
  // Don't capture space when typing in the name field
  document.getElementById("name").addEventListener("keydown", (e) => {
    if (e.code === "Space") e.stopPropagation();
  });
})();
</script>
</body>
</html>
